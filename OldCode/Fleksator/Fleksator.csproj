<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;net10.0</TargetFrameworks>
    <UseWindowsForms Condition="'$(TargetFramework)' == 'net48'">true</UseWindowsForms>
    <RootNamespace>SharpDevs.Fleksator</RootNamespace>
    <AssemblyName>SharpDevs.Fleksator</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Adjective.cs;DeclinativeWord.cs;Noun.cs;Verb.cs;Word.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <Compile Remove="Edit\**\*.cs" />
    <EmbeddedResource Remove="Edit\**\*.resx" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Translations.en-US.txt" />
    <EmbeddedResource Include="Translations.pl-PL.txt" />
  </ItemGroup>
</Project>
